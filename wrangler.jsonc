{
  "name": "rafeeq-study",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "keep_vars": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "vars": {
    "SITE_NAME": "رفيق المذاكرة",
    "AI_PROVIDER": "gemini",
    "DEFAULT_DAYS": "30",
    "DEFAULT_DAILY_LIMIT": "25",
    "DEFAULT_MAX_DEVICES": "2"
  }
}
